{
  "name": "loco-js-model",
  "version": "2.0.1",
  "description": "Model part of loco-js",
  "type": "module",
  "main": "dist/loco-model.mjs",
  "module": "dist/loco-model.mjs",
  "exports": {
    ".": "./dist/loco-model.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky && npm run build",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js --fix",
    "lint-staged": "lint-staged",
    "build": "webpack --mode=production --config-node-env=production -c webpack.config.js --progress",
    "start": "node dev/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locoframework/loco-js-model.git"
  },
  "keywords": [
    "model",
    "loco",
    "framework"
  ],
  "author": "Zbigniew Humeniuk <hello@artofcode.co>",
  "license": "MIT",
  "homepage": "http://locoframework.org",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "express": "^5.2.1",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "webpack": "^5.101.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^7.4.5"
  },
  "browserslist": [
    "defaults"
  ]
}
